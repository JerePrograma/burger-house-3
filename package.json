{
  "name": "burger-house-3",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "node scripts/install-ci.mjs",
    "dev": "vite --config vite.config.pages.ts",
    "build": "vite build --config vite.config.pages.ts",
    "build:cloudflare": "vite build --config vite.config.pages.ts --mode cloudflare",
    "build:management": "vite build --config vite.config.pages.ts --mode management",
    "catalog:seed": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/build-catalog-snapshot.mjs",
    "catalog:sync": "node --experimental-strip-types --import ./scripts/register-ts.mjs scripts/sync-published-catalog.mjs",
    "frontend:publish": "npm run deploy:vps",
    "frontend:deploy": "npm run deploy:vps",
    "management:publish": "npm run deploy:vps",
    "management:deploy": "npm run deploy:vps",
    "editor:deploy": "npm run deploy:vps",
    "build:native": "vite build --config vite.config.pages.ts --mode native",
    "android:sync": "npm run build:native && cap sync android",
    "android:open": "npm run android:sync && cap open android",
    "android:apk": "npm run android:sync && node scripts/android-build.mjs assembleDebug",
    "android:bundle": "npm run android:sync && node scripts/android-build.mjs bundleRelease",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --import ./scripts/register-ts.mjs --test tests/*.test.mjs deployment/vps/*.test.mjs",
    "preview": "vite preview --config vite.config.pages.ts --host 127.0.0.1",
    "backend:dev": "wrangler dev --config backend/wrangler.jsonc --port 8787 --var FRONTEND_URL:http://127.0.0.1:5173/burger-house-3",
    "backend:deploy": "npm run deploy:vps",
    "build:legacy": "node scripts/run-framework.mjs build",
    "parity:check": "node scripts/check-shared-code.mjs",
    "legacy:cloudflare:frontend:deploy": "npm run catalog:sync && npm run build:cloudflare && npm run frontend:publish",
    "legacy:cloudflare:frontend:publish": "node scripts/publish-static-catalog.mjs",
    "legacy:cloudflare:management:deploy": "npm run build:management && npm run management:publish",
    "legacy:cloudflare:management:publish": "wrangler deploy --config backend/management-wrangler.jsonc",
    "legacy:cloudflare:backend:deploy": "wrangler deploy --config backend/wrangler.jsonc",
    "legacy:cloudflare:editor:deploy": "wrangler deploy --config backend/catalog-wrangler.jsonc",
    "legacy:cloudflare:backend:migrate": "wrangler d1 migrations apply DB --remote --config backend/wrangler.jsonc",
    "legacy:cloudflare:editor:migrate": "wrangler d1 migrations apply DB --remote --config backend/catalog-wrangler.jsonc",
    "deploy:vps": "node scripts/deploy-vps.mjs",
    "test:vps": "node --test deployment/vps/*.test.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/browser": "8.0.5",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/share": "8.0.3",
    "@hookform/resolvers": "^5.7.1",
    "@ionic/react": "9.0.8",
    "@ionic/react-router": "9.0.8",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "react-router": "6.30.6",
    "react-router-dom": "6.30.6",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "json-rpc-2.0": "1.7.1",
    "raw-body": "3.0.2",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "overrides": {
    "miniflare": {
      "sharp": "0.35.4"
    }
  }
}
